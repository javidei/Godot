    {
      "id": "scene_discovery",
      "event": "scene_discovered",
      "id_template": "scene_{scene_id}",
      "amount": 20,
      "unique": true,
      "required_context": ["scene_id"],
      "enabled": true
    },
    {
      "id": "special_event",
      "event": "special_event",
      "id_template": "event_{event_id}",
      "amount": 30,
      "unique": true,
      "required_context": ["event_id"],
      "enabled": true
    },
    {
      "id": "hidden_collectible",
      "event": "hidden_collectible_found",
      "id_template": "hidden_{collectible_id}",
      "amount": 10,
      "unique": true,
      "required_context": ["collectible_id"],
      "enabled": true
    },
    {
      "id": "repeatable_activity",
      "event": "repeatable_activity_completed",
      "id_template": "activity_{activity_id}",
