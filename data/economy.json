{
  "schema_version": 1,
  "currency": {
    "id": "coins",
    "name": "MONEDAS",
    "initial_balance": 0
  },
  "activity": {
    "idle_timeout_seconds": 300.0,
    "profile_flush_seconds": 30.0
  },
