; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters here are not obvious.
;
; Format:
;   [section]
;   param=value assigning values to them.

config_version=5

[application]

config/name="Entre líneas: La novena silla"
config/version="0.9.42"
run/main_scene="res://scenes/naranjal_studio_splash.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/ui/menu-lineup.png"

[autoload]

DataManager="*res://autoload/data_manager_v103.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
[audio]

driver/enable_input=false

; 0.9.26: retirado el experimento de créditos 35 mm; Portugal vuelve a Monocraft limpio, sin vibración ni shader.
; 0.9.27: el duelo de insultos de Javi pasa al Día 3 y se presenta mediante una introducción narrativa con guiño a una aventura pirata clásica.
; 0.9.28: eliminada la ruta heredada que podía volver a mostrar el aviso antiguo de Javi; la introducción narrativa se fuerza tras cada reconstrucción de Story.
; 0.9.29: los guardados antiguos dentro de Javi en el Día 3 migran al prólogo narrativo y dejan de continuar por el diálogo anterior.
; 0.9.30: la transición real del mapa prepara el duelo persistente de Javi y deja de ejecutar el reroll heredado de 0.9.8 en el Día 3.
; 0.9.31: el prólogo de Javi solo se consume al llegar al primer insulto y el hotspot de monitores se desactiva mientras hay respuestas visibles.
; 0.9.32: el diálogo solo avanza desde su panel inferior y las revisitas muestran el reencuentro dentro de la habitación en vez de una pantalla negra.
; 0.9.33: el selector de protagonista sincroniza sus retratos con la apariencia seleccionada en Extras -> Personajes.
; 0.9.34: las imágenes de Extras -> Lugares se pueden abrir a pantalla completa y volver al listado con un único botón Atrás.
; 0.9.35: el visor de Lugares añade zoom táctil hasta 5x, arrastre y doble toque para inspeccionar detalles en móvil web.
; 0.9.36: Pixel Adventure se abre como pestaña controlada desde Entre líneas para que su portal pueda cerrarla y devolver el foco al juego.
; 0.9.37: el aviso de Portugal se sustituye por diez frases narrativas aleatorias con atribuciones humorísticas al iniciar una nueva historia.
; 0.9.38: nuevas partidas con Invitado fijo, motor data-driven de rutas/pistas/decisiones/easter eggs y bucle repetible de insultos de Javi.
; 0.9.39: Charlie se incorpora como octavo miembro del grupo, con ficha, habitación provisional, mapa y arco propio Trípode -> tarta -> cámara de La Palanca; el Argentino añade su frase de la carita sonriente.
; 0.9.40: Charlie usa su retrato real y su habitación deja de utilizar el fondo provisional.
; 0.9.41: primera revisión de guion con nuevas frases de apertura, un Día 1 más natural y los primeros diálogos revisados de Javi.
; 0.9.42: restauradas constantes vacías de compatibilidad para compilar la cadena heredada de transiciones sin recuperar el texto de 2026.
